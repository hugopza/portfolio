---
import styles from "./DecisionList.module.css";

interface Props {
  decisions: {
    title: string;
    rationale: string;
    tradeoff?: string;
  }[];
}

const { decisions } = Astro.props;
---

<div class={styles.list}>
  {
    decisions.map((decision, index) => (
      <article class={styles.row}>
        <span class={styles.index}>0{index + 1}</span>
        <h3>{decision.title}</h3>
        <p>{decision.rationale}</p>
        {decision.tradeoff && <p class={styles.tradeoff}>Tradeoff: {decision.tradeoff}</p>}
      </article>
    ))
  }
</div>
