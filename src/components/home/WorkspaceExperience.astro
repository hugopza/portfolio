---
import type { CollectionEntry } from "astro:content";
import styles from "./WorkspaceExperience.module.css";
interface Props { projects: CollectionEntry<"projects">[]; }
const { projects } = Astro.props;
---

<div class={styles.boot} data-boot aria-hidden="true">
  <div><span>HUGO_OS 2.0</span><p data-boot-line>Loading workspace modules...</p><i></i></div>
</div>

<div class={styles.progress} aria-hidden="true"><span data-scroll-progress></span></div>

<div class={styles.story} data-story>
  <div class={styles.stageWrap} aria-hidden="true">
    <div class={styles.stage} data-stage>
      <div class={styles.orbit} data-orbit></div>
      <div class={styles.window} data-window>
        <div class={styles.windowBar}>
          <span></span><span></span><span></span>
          <p>hugo@workspace — zsh</p>
        </div>
        <div class={styles.terminal} data-terminal>
          <p><b>hugo@portfolio</b>:<em>~</em>$ whoami</p>
          <h2>Software engineer.<br/><span>Product builder.</span></h2>
          <p class={styles.result}>I turn ambiguous problems into reliable, usable systems.</p>
          <div class={styles.command}><b>→</b><span data-command>open --selected-work</span><i></i></div>
        </div>

        <div class={styles.profile} data-profile>
          <div class={styles.profileTop}><span>PROFILE.JSON</span><span>01 / 03</span></div>
          <pre><code>{`{
  "name": "Hugo Perez",
  "focus": ["product", "mobile", "systems"],
  "method": "understand → design → build",
  "status": "open_to_opportunities"
}`}</code></pre>
        </div>

        <div class={styles.network} data-network>
          <svg viewBox="0 0 700 440" role="presentation">
            <path data-path d="M110 220 C210 50 300 80 350 210 S520 390 600 210" />
            <path data-path d="M110 220 C230 380 420 350 600 210" />
            <path data-path d="M350 210 C390 70 520 80 600 210" />
          </svg>
          <span class={styles.node} style="--x:12%;--y:48%">CLIENT<small>Astro / React</small></span>
          <span class={styles.node} style="--x:44%;--y:44%">LOGIC<small>TypeScript / Python</small></span>
          <span class={styles.node} style="--x:78%;--y:46%">DATA<small>Postgres / APIs</small></span>
          <span class={styles.packet} data-packet></span>
        </div>

        <div class={styles.deploy} data-deploy>
          <p><span>DEPLOYMENTS</span><span>3 systems online</span></p>
          {projects.slice(0, 3).map((project, index) => (
            <div class={styles.deployRow}>
              <span>0{index + 1}</span><strong>{project.data.title}</strong><i>{project.data.status}</i>
            </div>
          ))}
        </div>

        <div class={styles.connect} data-connect>
          <span>SECURE CHANNEL</span>
          <div><i></i><i></i><i></i><i></i><i></i></div>
          <strong>Let’s build something<br/>that holds up.</strong>
          <p>Connection ready · Madrid / Remote</p>
        </div>
      </div>
      <div class={styles.stageMeta}><span data-scene-label>00 / INDEX</span><span>SCROLL TO EXECUTE ↓</span></div>
    </div>
  </div>

  <div class={styles.chapters}>
    <section id="hero" class={styles.chapter} data-chapter="hero">
      <div class={styles.copy}>
        <span class="eyebrow">Available for selected opportunities</span>
        <h1>Engineering with<br/><span>intent.</span></h1>
        <p>I design and build digital products where interface quality, architecture and real constraints all matter.</p>
        <div class={styles.actions}><a href="#projects">Explore work <span>↓</span></a><a href="/assets/Hugo_Perez_Araus_CV_Cat-Es-En_2026.pdf" target="_blank">Open CV ↗</a></div>
      </div>
    </section>

    <section id="about" class={styles.chapter} data-chapter="about">
      <div class={styles.copy}>
        <span class="eyebrow">01 / About</span>
        <h2>Curiosity started it.<br/><span>Systems thinking shaped it.</span></h2>
        <p>I work from the problem outward: understand the users, map the constraints, then choose the simplest architecture that can remain dependable.</p>
        <a class={styles.textLink} href="/about/">Read my approach ↗</a>
      </div>
    </section>

    <section id="systems" class={styles.chapter} data-chapter="systems">
      <div class={styles.copy}>
        <span class="eyebrow">02 / Capabilities</span>
        <h2>From interface<br/><span>to infrastructure.</span></h2>
        <p>Product design, mobile architecture, frontend systems, APIs and data flows treated as one connected experience.</p>
        <ul class={styles.capabilities}><li>Product & UX engineering</li><li>React Native & native Android</li><li>TypeScript, Python & Supabase</li></ul>
      </div>
    </section>

    <section id="projects" class={`${styles.chapter} ${styles.projectsChapter}`} data-chapter="projects">
      <div class={styles.copy}>
        <span class="eyebrow">03 / Selected deployments</span>
        <h2>Built for real<br/><span>constraints.</span></h2>
        <p>Three projects, each organized around the decisions that made it work.</p>
        <div class={styles.projectLinks}>
          {projects.slice(0, 3).map((project, index) => (
            <a href={`/projects/${project.slug}/`}>
              <span>0{index + 1}</span><div><strong>{project.data.title}</strong><small>{project.data.summary}</small></div><i>↗</i>
            </a>
          ))}
        </div>
        <a class={styles.textLink} href="/projects/">View all project files ↗</a>
      </div>
    </section>

    <section id="contact" class={styles.chapter} data-chapter="contact">
      <div class={styles.copy}>
        <span class="eyebrow">04 / Open channel</span>
        <h2>Have a complex<br/><span>problem?</span></h2>
        <p>Tell me what needs to work, who it needs to serve and what cannot fail. We can start from there.</p>
        <div class={styles.actions}><a href="mailto:hugoperezaraus@gmail.com">Send an email ↗</a><button type="button" data-bot-open>Ask Hugo.bot</button></div>
      </div>
    </section>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>("[data-story]");
  if (root) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let lenis: Lenis | null = null;
    let raf = 0;
    if (!reduced) {
      lenis = new Lenis({ duration: 1.05, smoothWheel: true });
      const frame = (time: number) => { lenis?.raf(time); raf = requestAnimationFrame(frame); };
      raf = requestAnimationFrame(frame);
      lenis.on("scroll", ScrollTrigger.update);
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => link.addEventListener("click", (event) => {
        const target = document.querySelector(link.hash);
        if (target) { event.preventDefault(); lenis?.scrollTo(target as HTMLElement, { offset: 0 }); }
      }));
    }

    const labels: Record<string, string> = { hero: "00 / INDEX", about: "01 / PROFILE", systems: "02 / SYSTEMS", projects: "03 / DEPLOYMENTS", contact: "04 / CONNECT" };
    const sceneLabel = root.querySelector<HTMLElement>("[data-scene-label]");
    const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
    const ctx = gsap.context(() => {
      ScrollTrigger.create({ trigger: root, start: "top top", end: "bottom bottom", onUpdate: (self) => gsap.set(progress, { scaleX: self.progress }) });
      const mm = gsap.matchMedia();
      mm.add({ desktop: "(min-width: 901px)", reduce: "(prefers-reduced-motion: reduce)" }, (context) => {
        if (context.conditions?.reduce) return;
        gsap.from("[data-window]", { y: 80, rotationX: 8, autoAlpha: 0, duration: 1.2, ease: "power3.out", delay: .2 });
        gsap.to("[data-orbit]", { rotation: 180, ease: "none", scrollTrigger: { trigger: root, start: "top top", end: "bottom bottom", scrub: 1 } });
        const scenes = [
          { id: "about", show: "[data-profile]", hide: "[data-terminal]", command: "cat ./profile.json", rotate: -2 },
          { id: "systems", show: "[data-network]", hide: "[data-profile]", command: "trace --architecture", rotate: 2 },
          { id: "projects", show: "[data-deploy]", hide: "[data-network]", command: "deploy --selected-work", rotate: -1 },
          { id: "contact", show: "[data-connect]", hide: "[data-deploy]", command: "ssh hello@hugopza.dev", rotate: 0 },
        ];
        scenes.forEach((scene) => {
          const tl = gsap.timeline({ scrollTrigger: { trigger: `#${scene.id}`, start: "top 72%", end: "top 28%", scrub: 1 } });
          tl.to(scene.hide, { autoAlpha: 0, y: -24, duration: .35, ease: "power2.in" })
            .fromTo(scene.show, { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: .65, ease: "power2.out" }, .25)
            .to("[data-window]", { rotationY: scene.rotate, duration: 1, ease: "none" }, 0);
          ScrollTrigger.create({ trigger: `#${scene.id}`, start: "top center", end: "bottom center", onEnter: () => { if (sceneLabel) sceneLabel.textContent = labels[scene.id]; }, onEnterBack: () => { if (sceneLabel) sceneLabel.textContent = labels[scene.id]; } });
        });
        gsap.fromTo("[data-path]", { strokeDashoffset: 800 }, { strokeDashoffset: 0, ease: "none", scrollTrigger: { trigger: "#systems", start: "top 75%", end: "center center", scrub: 1 } });
        gsap.to("[data-packet]", { offsetDistance: "100%", ease: "none", scrollTrigger: { trigger: "#systems", start: "top 60%", end: "bottom 40%", scrub: 1 } });
      });
      document.querySelectorAll<HTMLElement>("[data-chapter]").forEach((chapter) => ScrollTrigger.create({ trigger: chapter, start: "top 55%", end: "bottom 45%", onToggle: (self) => { if (self.isActive && sceneLabel) sceneLabel.textContent = labels[chapter.dataset.chapter || "hero"]; } }));
    }, root);

    const boot = document.querySelector<HTMLElement>("[data-boot]");
    if (boot) { if (reduced || sessionStorage.getItem("workspace-booted")) boot.remove(); else { sessionStorage.setItem("workspace-booted", "1"); gsap.timeline().to("[data-boot-line]", { textContent: "All systems operational.", duration: .2, delay: .45 }).to(boot, { autoAlpha: 0, duration: .55, delay: .35, onComplete: () => boot.remove() }); } }
    window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
    document.addEventListener("astro:before-swap", () => { ctx.revert(); lenis?.destroy(); cancelAnimationFrame(raf); }, { once: true });
  }
</script>
